        "content": "<div style=\"width: 100%; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\">\n  <!-- Cards Resumo de Overfitting / Underfitting -->\n  <div style=\"display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap;\">\n    <div style=\"flex: 1; min-width: 180px; background: rgba(16, 185, 129, 0.12); border: 1px solid #10b981; border-radius: 8px; padding: 12px 16px;\">\n      <div style=\"font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8;\">Ajuste Ótimo (Good Fit)</div>\n      <div style=\"font-size: 1.5rem; font-weight: 700; color: #10b981;\">7 modelos</div>\n      <div style=\"font-size: 0.75rem; color: #64748b; margin-top: 2px;\">Generalização consistente</div>\n    </div>\n    <div style=\"flex: 1; min-width: 180px; background: rgba(239, 68, 68, 0.12); border: 1px solid #ef4444; border-radius: 8px; padding: 12px 16px;\">\n      <div style=\"font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8;\">Superajuste (Overfitting)</div>\n      <div style=\"font-size: 1.5rem; font-weight: 700; color: #ef4444;\">0 modelos</div>\n      <div style=\"font-size: 0.75rem; color: #64748b; margin-top: 2px;\">Erro Teste &gt;&gt; Erro Treino</div>\n    </div>\n    <div style=\"flex: 1; min-width: 180px; background: rgba(56, 189, 248, 0.12); border: 1px solid #38bdf8; border-radius: 8px; padding: 12px 16px;\">\n      <div style=\"font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8;\">Subajuste (Underfitting)</div>\n      <div style=\"font-size: 1.5rem; font-weight: 700; color: #38bdf8;\">3 modelos</div>\n      <div style=\"font-size: 0.75rem; color: #64748b; margin-top: 2px;\">Alto viés em ambas partições</div>\n    </div>\n  </div>\n\n  <!-- Gráficos de Barras Comparativos (Treino vs Teste) -->\n  <div style=\"background: rgba(30, 41, 59, 0.45); border: 1px solid rgba(148, 163, 184, 0.18); border-radius: 8px; padding: 14px 18px; margin-bottom: 14px;\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;\">\n    <div style=\"display: flex; align-items: center; gap: 10px;\">\n      <span style=\"font-size: 1.15rem; font-weight: 700; color: #f8fafc;\">Random forest</span>\n      <span style=\"font-size: 0.75rem; padding: 3px 10px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid #10b981; font-weight: 600;\">🟢 Ajuste Ótimo (Good Fit)</span>\n    </div>\n    <div style=\"display: flex; align-items: center; gap: 8px;\">\n      <span style=\"font-size: 0.82rem; color: #94a3b8;\">Gap de Generalização (Δ):</span>\n      <span style=\"font-size: 1.05rem; font-weight: 700; color: #34d399;\">+2.4%</span>\n    </div>\n  </div>\n\n  <!-- Barra Treino / CV -->\n  <div style=\"display: flex; align-items: center; margin-bottom: 6px; font-size: 0.82rem;\">\n    <span style=\"width: 145px; color: #94a3b8; font-weight: 500;\">Treino (Val. Cruzada):</span>\n    <div style=\"flex: 1; background: rgba(51, 65, 85, 0.5); border-radius: 4px; height: 20px; overflow: hidden; margin-right: 14px;\">\n      <div style=\"background: linear-gradient(90deg, #0284c7, #38bdf8); width: 43%; height: 100%; border-radius: 4px;\"></div>\n    </div>\n    <span style=\"width: 190px; text-align: right; color: #38bdf8; font-weight: 600;\">R$ 123,447.88 <span style=\"color: #64748b; font-size: 0.75rem; font-weight: 400;\">(R² 0.978)</span></span>\n  </div>\n\n  <!-- Barra Teste / Holdout -->\n  <div style=\"display: flex; align-items: center; margin-bottom: 8px; font-size: 0.82rem;\">\n    <span style=\"width: 145px; color: #94a3b8; font-weight: 500;\">Teste (Holdout):</span>\n    <div style=\"flex: 1; background: rgba(51, 65, 85, 0.5); border-radius: 4px; height: 20px; overflow: hidden; margin-right: 14px;\">\n      <div style=\"background: linear-gradient(90deg, #9333ea, #c084fc); width: 44%; height: 100%; border-radius: 4px;\"></div>\n    </div>\n    <span style=\"width: 190px; text-align: right; color: #c084fc; font-weight: 600;\">R$ 126,419.00 <span style=\"color: #64748b; font-size: 0.75rem; font-weight: 400;\">(R² 0.912)</span></span>\n  </div>\n\n  <!-- Rodapé com Diagnóstico e Recomendação -->\n  <div style=\"font-size: 0.78rem; color: #94a3b8; border-top: 1px dashed rgba(148, 163, 184, 0.2); padding-top: 8px; margin-top: 6px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;\">\n    <div><strong>Análise:</strong> Excelente equilíbrio entre viés e variância: generalização estável com baixos resíduos preditivos.</div>\n    <div><strong>Recomendação:</strong> <span style=\"color: #cbd5e1;\">Modelo ideal para promoção produtiva ou para compor comitê de votação.</span></div>\n  </div>\n</div>\n<div style=\"background: rgba(30, 41, 59, 0.45); border: 1px solid rgba(148, 163, 184, 0.18); border-radius: 8px; padding: 14px 18px; margin-bottom: 14px;\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;\">\n    <div style=\"display: flex; align-items: center; gap: 10px;\">\n      <span style=\"font-size: 1.15rem; font-weight: 700; color: #f8fafc;\">Xgboost</span>\n      <span style=\"font-size: 0.75rem; padding: 3px 10px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid #10b981; font-weight: 600;\">🟢 Ajuste Ótimo (Good Fit)</span>\n    </div>\n    <div style=\"display: flex; align-items: center; gap: 8px;\">\n      <span style=\"font-size: 0.82rem; color: #94a3b8;\">Gap de Generalização (Δ):</span>\n      <span style=\"font-size: 1.05rem; font-weight: 700; color: #34d399;\">-0.9%</span>\n    </div>\n  </div>\n\n  <!-- Barra Treino / CV -->\n  <div style=\"display: flex; align-items: center; margin-bottom: 6px; font-size: 0.82rem;\">\n    <span style=\"width: 145px; color: #94a3b8; font-weight: 500;\">Treino (Val. Cr