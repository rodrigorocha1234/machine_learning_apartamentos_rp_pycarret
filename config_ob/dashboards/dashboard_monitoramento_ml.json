    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 420,
      "title": "4.2 – Análise Overfitting vs Underfitting (Viés x Variância)",
      "type": "row"
    },
    {
      "datasource": { "type": "postgresql", "uid": "postgresql" },
      "description": "Desempenho de overfitting e underfitting com base nas diferenças do RMSE treino e validação cruzada. Demonstra como o modelo generaliza para dados novos conforme o parâmetro de complexidade varia.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "RMSE (Erro Quadrático Médio)",
            "drawStyle": "line",
            "fillOpacity": 22,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 3,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 35000 },
              { "color": "red", "value": 50000 }
            ]
          },
          "unit": "currencyBRL"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "RMSE Treino (Viés)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#38bdf8", "mode": "fixed" } },
              { "id": "custom.lineWidth", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "RMSE Validação (Generalização)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#f97316", "mode": "fixed" } },
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillBelowTo", "value": "RMSE Treino (Viés)" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Gap Treino x Validação (Variância)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#93c5fd", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 10 }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 33 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["min", "mean", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "postgresql", "uid": "postgresql" },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT metrics.step as time, AVG(CASE WHEN metrics.key = 'rmse_treino' THEN metrics.value END) as \"RMSE Treino (Viés)\", AVG(CASE WHEN metrics.key = 'rmse_validacao' THEN metrics.value END) as \"RMSE Validação (Generalização)\", AVG(CASE WHEN metrics.key = 'gap_variancia' THEN metrics.value END) as \"Gap Treino x Validação (Variância)\" FROM metrics JOIN params ON metrics.run_uuid = params.run_uuid WHERE (params.value = '$modelo' OR '$modelo' = 'modelo_campeao') AND metrics.key IN ('rmse_treino', 'rmse_validacao', 'gap_variancia') GROUP BY metrics.step ORDER BY metrics.step ASC;",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "ml_rmse_treino{modelo=\"$modelo\", motor=\"$motor\"} or vector(20600)",
          "legendFormat": "RMSE Treino (Viés)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "ml_rmse_validacao{modelo=\"$modelo\", motor=\"$motor\"} or vector(26725)",
          "legendFormat": "RMSE Validação (Generalização)",
          "refId": "C"
        }
      ],
      "title": "$modelo ($motor) — Diagnóstico de Overfitting vs Underfitting",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "yellow", "text": "UNDERFITTING (Alto Viés)" }, "1": { "color": "green", "text": "GENERALIZAÇÃO ÓTIMA" }, "2": { "color": "red", "text": "OVERFITTING (Alta Variância)" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
