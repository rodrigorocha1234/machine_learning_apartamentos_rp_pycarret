          "rawSql": "SELECT params.value as \"Modelo\", MIN(CASE WHEN metrics.key = 'rmse_treino' THEN metrics.value END) as \"RMSE Treino (Viés)\", MIN(CASE WHEN metrics.key = 'rmse_validacao' THEN metrics.value END) as \"RMSE Validação (Generalização)\", (MIN(CASE WHEN metrics.key = 'rmse_validacao' THEN metrics.value END) - MIN(CASE WHEN metrics.key = 'rmse_treino' THEN metrics.value END)) as \"Gap (Variância)\", CASE WHEN (MIN(CASE WHEN metrics.key = 'rmse_validacao' THEN metrics.value END) - MIN(CASE WHEN metrics.key = 'rmse_treino' THEN metrics.value END)) > 8000 THEN 'OVERFITTING' WHEN MIN(CASE WHEN metrics.key = 'rmse_treino' THEN metrics.value END) > 40000 THEN 'UNDERFITTING' ELSE 'ÓTIMO' END as \"Diagnóstico\" FROM metrics JOIN params ON metrics.run_uuid = params.run_uuid WHERE params.key = 'modelo' GROUP BY params.value ORDER BY \"Gap (Variância)\" ASC;",
