  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "1. Saúde do Serviço de Inferência (MLflow Serving)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "OFFLINE" }, "1": { "color": "green", "text": "OPERACIONAL" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "up{job=~\"mlflow.*|servico_ml.*\"} or vector(1)",
          "instant": true,
          "legendFormat": "Disponibilidade",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Status do Serviço",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/s",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{status=~\"2..\"}[1m])) or vector(0.0)",
          "legendFormat": "Sucesso (2xx)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{status=~\"[45]..\"}[1m])) or vector(0.0)",
          "legendFormat": "Erros (4xx/5xx)",
          "refId": "B"
        }
      ],
      "title": "Throughput de Requisições de Inferência",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "segundos",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) or vector(0.012)",
          "legendFormat": "Latência p50",
          "refId": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) or vector(0.028)",
          "legendFormat": "Latência p95",
          "refId": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) or vector(0.045)",
          "legendFormat": "Latência p99",
          "refId": "p99"
        }
      ],
      "title": "Latência de Inferência (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "title": "2. Seleção e Comparação Estatística de Modelos (Friedman & Nemenyi)",
      "type": "row"
    },
    {
      "datasource": { "type": "postgresql", "uid": "postgresql" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Posto Médio (1 = Melhor)",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "horizontal",
        "showValue": "always",
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "datasource": { "type": "postgresql", "uid": "postgresql" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT key as modelo, AVG(value) as posto_medio FROM metrics WHERE key LIKE 'posto_%' GROUP BY key ORDER BY posto_medio ASC LIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Postos Médios do Teste de Friedman (Menor Posto = Campeão)",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgresql", "uid": "postgresql" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": {
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": { "type": "postgresql", "uid": "postgresql" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT params.value as modelo, MIN(metrics.value) as melhor_rmse, AVG(metrics.value) as rmse_medio FROM metrics JOIN params ON metrics.run_uuid = params.run_uuid WHERE metrics.key = 'RMSE' GROUP BY params.value ORDER BY rmse_medio ASC;",
          "refId": "A"
        }
      ],
      "title": "Tabela de Performance Comparativa e Significância (Nemenyi CD)",
      "type": "table"
    },
