          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT params.value as modelo, MIN(metrics.value) as melhor_rmse, AVG(metrics.value) as rmse_medio FROM metrics JOIN params ON metrics.run_uuid = params.run_uuid WHERE metrics.key = 'RMSE' GROUP BY params.value ORDER BY rmse_medio ASC;",
